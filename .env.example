# Copia este archivo a `.env` y rellena los valores reales.
# (.env NO se sube a git)

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Secreto para firmar la cookie de sesion (genera uno largo y aleatorio).
# Ej (PowerShell):  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Correos autorizados (solo ustedes dos), separados por coma.
ALLOWED_EMAILS=correo-uno@gmail.com,correo-dos@gmail.com

# URL base de la app. En local dejalo asi; en Vercel pon la URL del despliegue.
BASE_URL=http://localhost:8000
